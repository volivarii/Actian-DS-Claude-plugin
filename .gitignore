# OS
.DS_Store

# Claude Code local session files
.claude/
settings.json

# Generated output (teammates create their own via skills)
# Anchored to repo root so they don't accidentally match nested
# directories like plugins/*/vendor/components/.
/components/
/flows/
/presentations/
/prototypes/

# Dogfood/preview output generated in-plugin (local artifacts, not source).
/plugins/actian-design-system/flows/

# Annotation files (browser preview artifacts)
.annotations.json

# Test files (local dev artifacts)
test-*.html

# Python
*.pyc
__pycache__/

# Node
node_modules/

# Figma file keys (sensitive — create from .figma-keys.json.example)
plugins/*/.figma-keys.json

# Secrets / API tokens (Figma PAT, etc.) — create from .env.example
.env
.env.local
plugins/*/.env
plugins/*/.env.local

# Test prompts (local reference only)
plugins/*/TEST-PROMPTS.md

# Release notes (local drafts for Slack)
release-notes/

# Token drift reports (informational, generated by /sync-design-system)
token-drift.json

# Quality-ledger and pixel-diff files an older checkout may still hold, at both paths the tests
# have had: a pull does not remove them, and unignored they would ride a stage-everything commit
# back in (under plugins/, into the install).
tests/renderers/__fidelity__/quality-ledger.jsonl
tests/renderers/__fidelity__/diffs/
plugins/actian-design-system/tests/renderers/__fidelity__/quality-ledger.jsonl
plugins/actian-design-system/tests/renderers/__fidelity__/diffs/

# Superpowers working files (plans, specs, audits) — never tracked
# Globstar so this catches both repo-root docs/superpowers/ AND nested
# plugins/*/docs/superpowers/ paths.
**/docs/superpowers/
**/.superpowers/

# Root-level scratch docs
/docs/

# Communication
comms/


# Demo flow rendered deliverables (regenerable; embed ~340kb fonts)
demo-flows/*.html
demo-flows/*.flow.json

# GSD planning artifacts (codebase maps, phase plans) — never tracked
.planning/

# actian-ux-proposal writes its data file and document into the project working directory.
# They are a deliverable for the reader, not repo source.
proposals/
